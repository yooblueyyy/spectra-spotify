# Copy this file to .env and fill it in. Never share .env. The token controls your bot.
# All values come from https://discord.com/developers/applications → your app.

# Bot tab → Reset Token
DISCORD_TOKEN=

# General Information → Application ID
CLIENT_ID=

# Your server's ID: Discord settings → Advanced → Developer Mode, then right-click the server icon → Copy Server ID
GUILD_ID=
