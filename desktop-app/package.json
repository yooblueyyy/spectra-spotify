{
  "name": "spectra-desktop",
  "productName": "Spectra",
  "version": "1.4.0",
  "description": "Themes, extensions and snippets for the Spotify desktop app. Spicetify-compatible, no file patching.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare-ui": "node ../build.mjs --app",
    "start": "npm run prepare-ui && electron .",
    "dist": "npm run prepare-ui && electron-builder",
    "dist:dir": "npm run prepare-ui && electron-builder --dir",
    "dist:mac": "npm run prepare-ui && electron-builder --mac --publish never",
    "dist:linux": "npm run prepare-ui && electron-builder --linux --publish never",
    "dist:win": "npm run prepare-ui && electron-builder --win --publish never"
  },
  "build": {
    "appId": "app.spectra.desktop",
    "productName": "Spectra",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json",
      "!installer.nsh"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Spectra",
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "Spectra-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "minimumSystemVersion": "12.0",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Spectra-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "maintainer": "Spectra <support@usespectra.xyz>",
      "artifactName": "Spectra-${version}-linux-${arch}.${ext}",
      "executableName": "spectra",
      "synopsis": "Themes and extensions for Spotify",
      "description": "Spicetify themes, extensions and snippets for the Spotify desktop app, without patching any files.",
      "desktop": {
        "entry": {
          "StartupWMClass": "Spectra",
          "Keywords": "spotify;themes;spicetify;"
        }
      }
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "Spectra",
    "email": "support@usespectra.xyz"
  },
  "homepage": "https://usespectra.xyz"
}
