{
  "manifest_version": 3,
  "name": "Spectra: Spotify Themes & Extensions",
  "short_name": "Spectra",
  "version": "1.3.0",
  "description": "Spicetify themes, extensions and snippets for the Spotify web player. A standalone Spectra desktop app is available for the Spotify desktop client.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Spectra",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "dashboard/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["runtime/spectra-runtime.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["shared/core.js", "bridge.js"],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "111"
}
