{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/|downloads/).*)",
      "has": [
        {
          "type": "host",
          "value": "spectra-spotify.vercel.app"
        }
      ],
      "destination": "https://usespectra.xyz/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/|downloads/).*)",
      "has": [
        {
          "type": "host",
          "value": "spectra.yooblueyyy.com"
        }
      ],
      "destination": "https://usespectra.xyz/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.usespectra.xyz"
        }
      ],
      "destination": "https://usespectra.xyz/:path",
      "permanent": true
    }
  ]
}
